# ============================================================================
# Nyayota — Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit secret keys.
# ============================================================================

# Google Gemini AI API Key (Server-side secret, accessed via process.env.GEMINI_API_KEY)
# Required for live conversational response generation and streaming.
GEMINI_API_KEY="your-gemini-api-key-here"

# Public AI Assistant Availability Flag (Server-controlled)
# Set to 'false' (or leave unset) to keep the public assistant suspended with HTTP 503.
# Set to 'true' only after conversational models have been fully verified.
ENABLE_PUBLIC_AI_ASSISTANT="false"

# Gemini Model Identifiers (Optional overrides)
# Primary model for natural-language grounded responses:
GEMINI_MODEL="gemini-3.8-flash"
# Fallback model if primary model encounters rate limits or errors:
GEMINI_FALLBACK_MODEL="gemini-2.5-flash"

# Upstash Redis Distributed Rate Limiting (Recommended for Vercel Serverless production)
# When public assistant is enabled, distributed rate limiting prevents quota exhaustion across edge lambdas.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public Application URL for canonical metadata and absolute links
NEXT_PUBLIC_APP_URL="https://nyayota.vercel.app"
APP_URL="https://nyayota.vercel.app"
